# Use a unique password with at least 16 characters. Never commit your actual .env.
ADMIN_PASSWORD=replace-this-with-a-long-random-password
TMDB_READ_TOKEN=
# Optional OpenAI-compatible LM Studio server. The URL must be reachable from the organizer container.
LM_STUDIO_BASE_URL=
LM_STUDIO_MODEL=
LM_STUDIO_API_TOKEN=
# Optional: requires ENABLE_WRITES=true and read-write media mounts.
AUTO_APPLY_HIGH_CONFIDENCE=false
